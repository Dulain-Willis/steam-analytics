# Copy to .env (gitignored) and fill in. `.envrc` is one line — `dotenv` — so
# direnv loads this automatically on cd; otherwise `set -a; . ./.env; set +a`.
# See README.md for the whole developer setup.

# dev is the only target you run by hand. staging and prod run from Airflow.
DBT_TARGET=dev

# Snowflake account identifier, e.g. FMBSGSW-YU41950 (from the account URL).
SNOWFLAKE_ACCOUNT=

# Your developer Snowflake user and the role that goes with it. steam-infra's
# terraform/snowflake creates one user per entry in its `developers` list,
# named STEAM_DEV_<NAME>, and grants it DEVELOPER: reads STEAM_RAW, writes
# STEAM_DEV, and nothing at all in STEAM_STAGING or STEAM_PROD.
SNOWFLAKE_USER=STEAM_DEV_YOURNAME
SNOWFLAKE_ROLE=DEVELOPER

# The database this target builds into. Every developer shares STEAM_DEV and
# is separated by SNOWFLAKE_SCHEMA below, not by database.
SNOWFLAKE_DATABASE=STEAM_DEV

# Your developer schema prefix — REQUIRED, and deliberately not defaulted.
# Every schema your build writes is <SNOWFLAKE_SCHEMA>_<layer>:
# dbt_yourname_stg, dbt_yourname_marts_core, ... dbt refuses to run without
# it rather than writing into a schema you share with a teammate.
#
# Left empty on purpose, unlike every other value here: a placeholder that
# *works* is the failure this variable lost its default to prevent. Two people
# who copied this file and did not get to this line would both build into
# dbt_yourname_*, silently, which is the shared-schema collision the guard
# exists for. Empty fails the first command you run, naming this variable.
SNOWFLAKE_SCHEMA=

# Path to your RSA private key (PEM, PKCS#8, unencrypted) — the half whose
# public key is registered on your Snowflake user. Keep it outside the repo;
# never commit a real key. If the key is encrypted, also set
# DBT_ENV_SECRET_SNOWFLAKE_KEY_PASSPHRASE. Give the full path: nothing
# expands `~` in a dotenv file.
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.dbt/snowflake_key.p8

# Optional. Defaults: COMPUTE_WH (the account's only warehouse), 4 threads,
# and STEAM_RAW / STEAM_RDS for the CDC landing tables the sources read.
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# DBT_THREADS=4
# SNOWFLAKE_RAW_DATABASE=STEAM_RAW
# SNOWFLAKE_SOURCE_SCHEMA=STEAM_RDS
